# Copy to .kerno/.env. That file is gitignored.
# Non-secret issuer settings (audience, client id, domain, Ada's email) are already in .kerno/config.yaml.

# Same database the running app uses. Compose publishes Postgres on 5432.
# If you started with POSTGRES_HOST_PORT=5433, use that port here instead.
DATABASE_URL=postgres://northwharf:northwharf@127.0.0.1:5432/northwharf

# Local-dev defaults from the repository .env.example.
AUTH0_CLIENT_SECRET=northwharf-management-secret
AUTH0_MGMT_CLIENT_SECRET=northwharf-management-secret
AUTH0_OWNER_PASSWORD=ada-north-local
AUTH0_TEST_PASSWORD=ada-north-local

# JSON object of header name to value. Mint the token with the password grant
# in CONTRIBUTING.md (Ada North, audience http://localhost:8080/mcp). It expires
# after one hour; replace this value when it does.
MCP_AUTH_HEADERS={"Authorization":"Bearer <token>"}
