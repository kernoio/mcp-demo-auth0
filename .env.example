PORT=8080
DATABASE_URL=postgres://northwharf:northwharf@127.0.0.1:5432/northwharf
# Browser and Cursor reach the issuer and the MCP resource at these URLs.
AUTH0_ISSUER=http://localhost:3000
AUTH0_AUDIENCE=http://localhost:8080/mcp
AUTH0_JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json
AUTH0_OWNER_SUBJECT=auth0|6728f0a1b2c3d4e5f6789012

# The auth0 compose service is the issuer and listens on AUTH0_PORT inside the
# container. The host port is AUTH0_HOST_PORT (default 3000). Point
# AUTH0_JWKS_URL at that host port when it is not 3000.
# AUTH0_PORT=3000
# AUTH0_JWKS_URL=http://127.0.0.1:3011/.well-known/jwks.json

# A real Auth0 tenant sets AUTH0_ISSUER_BASE_URL instead of AUTH0_ISSUER.
# The app accepts either name as the expected token iss, and always fetches
# keys from AUTH0_JWKS_URL so the issuer host and the JWKS host can differ.
# AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
# AUTH0_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json

# Management API audience is the issuer plus api/v2/:
# http://localhost:3000/api/v2/
# Local-dev stand-in only. The Northwharf app does not read these.
# The same client mints a user access token with the password grant.
AUTH0_MGMT_CLIENT_ID=northwharf-management
AUTH0_MGMT_CLIENT_SECRET=northwharf-management-secret

# Password for the seeded owner ada.north@northwharf.example.
AUTH0_OWNER_EMAIL=ada.north@northwharf.example
AUTH0_OWNER_PASSWORD=ada-north-local
