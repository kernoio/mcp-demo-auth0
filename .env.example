PORT=8080
DATABASE_URL=postgres://northwharf:northwharf@127.0.0.1:5432/northwharf
AUTH0_ISSUER=https://auth.northwharf.local/
AUTH0_AUDIENCE=https://mcp.northwharf.local
AUTH0_JWKS_URL=http://127.0.0.1:3000/.well-known/jwks.json
AUTH0_BASE_URL=http://127.0.0.1:3000
AUTH0_OWNER_SUBJECT=auth0|ada.north

# localauth0 0.9.1 accepts only this built-in client. The app never reads it.
# A real Auth0 tenant can use client id northwharf and secret northwharf-dev-secret.
AUTH0_CLIENT_ID=client_id
AUTH0_CLIENT_SECRET=client_secret
